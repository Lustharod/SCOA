0" dy="342"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SCOA | MER/DER conceitual | Compras - recebimento e pagamento / 2" style="text;html=0;align=left;verticalAlign=middle;fontSize=23;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="20" width="1090" height="42" /></mxCell><mxCell id="legend" value="Retângulo: entidade  •  Losango: relacionamento  •  0..1: opcional  •  0..N: muitos  •  1: exatamente um" style="text;html=0;align=left;verticalAlign=middle;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="65" width="1090" height="28" /></mxCell><mxCell id="read" value="Cardinalidade junto à entidade: ocorrências dela para uma ocorrência da entidade oposta." style="text;html=0;align=left;verticalAlign=middle;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="94" width="1090" height="26" /></mxCell><mxCell id="same" value="Entidades repetidas nas linhas e nas vistas representam a mesma entidade do modelo integrado." style="text;html=0;align=left;verticalAlign=middle;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="120" width="1090" height="26" /></mxCell><mxCell id="0a" value="Pagamento da compra&#10;parcela; valor&#10;vencimento; data&#10;forma; situação" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fa;strokeColor=#355672;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="170" width="330" height="104" /></mxCell><mxCell id="0b" value="Transação financeira&#10;tipo; entidade externa&#10;valor; data&#10;situação" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fa;strokeColor=#355672;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="795" y="170" width="330" height="104" /></mxCell><mxCell id="0r" value="vincula transação" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#355672;fontFamily=Arial;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="181" width="200" height="82" /></mxCell><mxCell id="0ea" value="0..1" style="edgeStyle=none;html=0;endArrow=none;startArrow=none;fontSize=17;labelBackgroundColor=#ffffff;strokeColor=#355672;" edge="1" parent="1" source="0a" target="0r"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="0eb" value="0..1" style="edgeStyle=none;html=0;endArrow=none;startArrow=none;fontSize=17;labelBackgroundColor=#ffffff;strokeColor=#355672;" edge="1" parent="1" source="0r" target="0b"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="footer" value="Amarelo: entidade associativa com atributos de negócio. Atributos apresentados são uma seleção conceitual." style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="307" width="1090" height="25" /></mxCell></root></mxGraphModel></diagram><diagram id="param" name="Parâmetros e critérios de leitura"><mxGraphModel page="1" pageWidth="1160" pageHeight="800"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="notes" value="PARÂMETRO DO SISTEMA&#10;&#10;chave; valor; tipo; módulo; descrição; situação&#10;&#10;Entidade transversal independente: o modelo aprovado não define vínculo persistente com uma entidade específica.&#10;&#10;CRITÉRIOS DE TRANSFORMAÇÃO&#10;&#10;Usuário–Perfil e Perfil–Permissão: relacionamentos diretos muitos-para-muitos.&#10;Estrutura curricular–Disciplina: composição muitos-para-muitos.&#10;Disciplina–Disciplina: autorrelacionamento de pré-requisito; papéis disciplina e disciplina requerida.&#10;Entidades associativas de negócio permanecem no conceitual, com seus atributos próprios.&#10;Não são exibidos identificadores artificiais, chaves, tipos SQL ou restrições físicas.&#10;As vistas são projeções do mesmo MER; a vista de integração seleciona os vínculos entre módulos.&#10;&#10;Fonte: Modelo Lógico aprovado, capítulo 8, figuras 39 a 45 (2026)." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=25;fontSize=20;fillColor=#e8f1fa;strokeColor=#355672;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="40" width="1080" height="700" /></mxCell></root></mxGraphModel></diagram></mxfile>